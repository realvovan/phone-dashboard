<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: Weekday & Date -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/weekday_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="WED"
            android:textColor="#FF3737"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="20"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cards Container -->
    <LinearLayout
        android:id="@+id/cards_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/no_events_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="No events"
            android:textColor="#A0A0A0"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Card 0 -->
        <LinearLayout
            android:id="@+id/event_card_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/pill_0"
                android:layout_width="12dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/calendar_pill_background" />

            <RelativeLayout
                android:id="@+id/card_box_0"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/calendar_card_background"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/event_time_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:includeFontPadding="false"
                    android:text="20:00 - 21:00"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/event_title_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_above="@id/event_time_0"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:text="Event Title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Card 1 -->
        <LinearLayout
            android:id="@+id/event_card_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/pill_1"
                android:layout_width="12dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/calendar_pill_background" />

            <RelativeLayout
                android:id="@+id/card_box_1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/calendar_card_background"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/event_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:includeFontPadding="false"
                    android:text="20:00 - 21:00"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/event_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_above="@id/event_time_1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:text="Event Title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Card 2 -->
        <LinearLayout
            android:id="@+id/event_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/pill_2"
                android:layout_width="12dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/calendar_pill_background" />

            <RelativeLayout
                android:id="@+id/card_box_2"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/calendar_card_background"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/event_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:includeFontPadding="false"
                    android:text="20:00 - 21:00"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/event_title_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_above="@id/event_time_2"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:text="Event Title"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Page Indicator -->
    <TextView
        android:id="@+id/page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:includeFontPadding="false"
        android:text="page 1/2"
        android:textColor="#A0A0A0"
        android:textSize="12sp" />

</LinearLayout>
