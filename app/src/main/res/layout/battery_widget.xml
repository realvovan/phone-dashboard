<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/battery_container"
        android:layout_width="64dp"
        android:layout_height="32dp">

        <!-- Progress Fill -->
        <ProgressBar
            android:id="@+id/battery_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="48dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/battery_progress" />

        <!-- Battery Frame -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/battery_frame"
            tools:ignore="ContentDescription" />

        <!-- Charging Bolt -->
        <ImageView
            android:id="@+id/charging_bolt"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" android:src="@drawable/ic_lightning"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/battery_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="100%"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>